{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ErenTahiroglu/Evidence-Checkpoint-Engine/schemas/v0.1.0/assessment-output.schema.json",
  "title": "Evidence Checkpoint Assessment Output Contract (Draft R2)",
  "description": "Schema for deterministic verification assessments emitted by Evidence-Checkpoint-Engine. Separates machine-assessed facts from declared claims, independent reviews, and human authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "evaluator_auth",
    "engine",
    "evaluation_timestamp",
    "evaluated_target",
    "dimensions",
    "derived_summary",
    "claims_breakdown",
    "checks_performed",
    "checks_omitted",
    "exit_code"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["0.1.0-draft"]
    },
    "assessment_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_\\-\\.:]{1,64}$"
    },
    "evaluator_auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_context", "is_synthetic_mock"],
      "properties": {
        "execution_context": {
          "type": "string",
          "enum": [
            "LOCAL_SUBPROCESS_PIPE",
            "DETACHED_CRYPTOGRAPHIC_SIGNATURE",
            "SYNTHETIC_MOCK_UNTRUSTED"
          ]
        },
        "is_synthetic_mock": {
          "type": "boolean",
          "description": "True if this record was generated as an illustrative mock rather than genuine verifier output."
        },
        "signature_reference": {
          "type": "string"
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "canonicalization_standard"],
      "properties": {
        "name": { "type": "string", "enum": ["Evidence-Checkpoint-Engine"] },
        "version": { "type": "string" },
        "canonicalization_standard": { "type": "string", "enum": ["RFC8785"] },
        "build_commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" }
      }
    },
    "evaluation_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "evaluated_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "repository_owner",
        "repository_name",
        "target_commit_sha",
        "evaluated_checkpoint_id"
      ],
      "properties": {
        "repository_id": {
          "type": ["string", "null"],
          "pattern": "^[1-9][0-9]{0,19}$",
          "description": "Canonical decimal string of repository ID. Bounded by uint64::MAX (18446744073709551615) during semantic validation. Null when input cannot be parsed or target is unspecified."
        },
        "repository_owner": { "type": ["string", "null"] },
        "repository_name": { "type": ["string", "null"] },
        "target_commit_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40,64}$" },
        "evaluated_checkpoint_id": { "type": ["string", "null"] }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_integrity",
        "ci_execution",
        "evidence_availability",
        "review_status",
        "authorization",
        "freshness"
      ],
      "properties": {
        "evidence_integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "digest_match", "details"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["VALID", "INVALID", "CORRUPT", "TAMPERED", "NOT_EVALUATED"]
            },
            "digest_match": { "type": "boolean" },
            "details": { "type": "string" }
          }
        },
        "ci_execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "expected_jobs_count",
            "observed_jobs_count",
            "unresolved_jobs"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "VERIFIED_PASS",
                "FAILED",
                "INCOMPLETE_SKIPPED",
                "ATTEMPT_MISMATCH",
                "UNVERIFIED_RUN",
                "NOT_APPLICABLE"
              ]
            },
            "expected_jobs_count": { "type": "integer", "minimum": 0 },
            "observed_jobs_count": { "type": "integer", "minimum": 0 },
            "unresolved_jobs": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "evidence_availability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "expired_references"],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "AVAILABLE",
                "PARTIALLY_AVAILABLE",
                "EXPIRED",
                "UNREACHABLE",
                "NOT_PROVIDED",
                "NOT_EVALUATED"
              ]
            },
            "expired_references": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "review_status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "tier", "scope"],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "INDEPENDENT_REVIEW_PASS",
                "STATIC_PASS_WITH_LIMITATIONS",
                "SELF_REPORT_ONLY",
                "REVIEW_FAILED",
                "UNREVIEWED",
                "NOT_EVALUATED"
              ]
            },
            "tier": {
              "type": "string",
              "enum": ["NONE", "SELF_CLAIM", "STATIC_AUDIT", "INDEPENDENT_FULL"]
            },
            "scope": { "type": "string" },
            "reviewer_identity": { "type": ["string", "null"] }
          }
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "decision_by"],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "EXPLICITLY_AUTHORIZED",
                "AUTHORIZATION_PENDING",
                "REJECTED",
                "REVOKED"
              ]
            },
            "decision_by": { "type": ["string", "null"] },
            "authorization_scope": { "type": ["string", "null"] }
          }
        },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "live_head_sha"],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "CURRENT_HEAD",
                "HISTORICAL_BASELINE",
                "STALE_DIVERGED",
                "UNKNOWN_HEAD",
                "NOT_EVALUATED"
              ]
            },
            "live_head_sha": { "type": ["string", "null"] }
          }
        }
      }
    },
    "derived_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "blocking_reasons", "warnings"],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "ASSESSED_PROVISIONAL_PASS",
            "ASSESSED_LIMITATIONS",
            "ASSESSED_FAIL",
            "INSUFFICIENT_EVIDENCE",
            "REFUSED"
          ]
        },
        "blocking_reasons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "claims_breakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_declared",
        "machine_assessed",
        "independently_reviewed",
        "human_authorized"
      ],
      "properties": {
        "source_declared": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claimed_phase", "claimed_producer"],
          "properties": {
            "claimed_phase": { "type": ["string", "null"] },
            "claimed_producer": { "type": ["string", "null"] },
            "claimed_checkpoint_id": { "type": ["string", "null"] }
          }
        },
        "machine_assessed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha_verified", "repo_id_matched", "schema_conformant"],
          "properties": {
            "sha_verified": { "type": "boolean" },
            "repo_id_matched": { "type": "boolean" },
            "schema_conformant": { "type": "boolean" },
            "digest_verified": { "type": "boolean" }
          }
        },
        "independently_reviewed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["review_verdict"],
          "properties": {
            "review_verdict": { "type": "string" },
            "reviewer": { "type": ["string", "null"] },
            "audit_scope": { "type": ["string", "null"] }
          }
        },
        "human_authorized": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authorized"],
          "properties": {
            "authorized": { "type": "boolean" },
            "owner_signature_ref": { "type": ["string", "null"] }
          }
        }
      }
    },
    "checks_performed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "checks_omitted": {
      "type": "array",
      "items": { "type": "string" }
    },
    "exit_code": {
      "type": "integer",
      "enum": [0, 1, 2, 3, 4],
      "description": "0=Clean verification pass (ASSESSED_PROVISIONAL_PASS), 1=Limitations or warnings (ASSESSED_LIMITATIONS), 2=Verification failure (ASSESSED_FAIL), 3=Schema rejection/refusal/insufficient evidence (REFUSED/INSUFFICIENT_EVIDENCE), 4=Execution error."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evaluator_auth": {
            "properties": {
              "execution_context": { "const": "SYNTHETIC_MOCK_UNTRUSTED" }
            }
          }
        }
      },
      "then": {
        "properties": {
          "evaluator_auth": {
            "properties": {
              "is_synthetic_mock": { "const": true }
            }
          },
          "derived_summary": {
            "properties": {
              "verdict": {
                "enum": [
                  "ASSESSED_LIMITATIONS",
                  "ASSESSED_FAIL",
                  "INSUFFICIENT_EVIDENCE",
                  "REFUSED"
                ]
              }
            }
          },
          "claims_breakdown": {
            "properties": {
              "human_authorized": {
                "properties": {
                  "authorized": { "const": false }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evaluator_auth": {
            "properties": {
              "is_synthetic_mock": { "const": true }
            }
          }
        }
      },
      "then": {
        "properties": {
          "derived_summary": {
            "properties": {
              "verdict": {
                "enum": [
                  "ASSESSED_LIMITATIONS",
                  "ASSESSED_FAIL",
                  "INSUFFICIENT_EVIDENCE",
                  "REFUSED"
                ]
              }
            }
          },
          "claims_breakdown": {
            "properties": {
              "human_authorized": {
                "properties": {
                  "authorized": { "const": false }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "claims_breakdown": {
            "properties": {
              "human_authorized": {
                "properties": {
                  "authorized": { "const": true }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "evaluator_auth": {
            "properties": {
              "is_synthetic_mock": { "const": false }
            }
          },
          "dimensions": {
            "properties": {
              "authorization": {
                "properties": {
                  "status": { "const": "EXPLICITLY_AUTHORIZED" }
                }
              }
            }
          }
        }
      }
    }
  ]
}
