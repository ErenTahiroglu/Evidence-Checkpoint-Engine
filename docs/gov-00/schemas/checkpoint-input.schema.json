{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ErenTahiroglu/Evidence-Checkpoint-Engine/schemas/v0.1.0/checkpoint-input.schema.json",
  "title": "Evidence Checkpoint Input Payload Contract (Draft R2)",
  "description": "Schema for declared evidence checkpoint input payloads submitted to Evidence-Checkpoint-Engine. All contents are treated as unverified producer claims (SOURCE_DECLARED) until programmatically assessed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checkpoint_id",
    "phase",
    "timestamp",
    "repository",
    "source",
    "producer",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["0.1.0-draft"]
    },
    "checkpoint_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_\\-\\.:]{1,64}$",
      "description": "Unique identifier for this checkpoint proposal."
    },
    "phase": {
      "type": "string",
      "pattern": "^[A-Z0-9_\\-]{1,32}$",
      "description": "Governance or milestone gate identifier (e.g., GOV-00, BOOTSTRAP-00)."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
      "description": "Strict ISO-8601 UTC timestamp ending in Z."
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "name", "github_rest_id"],
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]{1,39}$"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-\\.]{1,100}$"
        },
        "github_rest_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$",
          "description": "Canonical decimal string of positive integer ID. Regex enforces canonical formatting (non-negative, no leading zeros, max 20 digits, no float notation). Programmatic semantic validation strictly bounds values to <= uint64::MAX (18446744073709551615) via integer parsing without float conversion."
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_sha", "git_hash_algorithm", "branch"],
      "properties": {
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$",
          "description": "Hexadecimal commit hash (40 chars for SHA-1, 64 chars for SHA-256)."
        },
        "git_hash_algorithm": {
          "type": "string",
          "enum": ["sha1", "sha256"],
          "default": "sha1",
          "description": "Git object hash algorithm used by the repository."
        },
        "tree_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$",
          "description": "Optional hexadecimal Git tree hash (length matches algorithm)."
        },
        "branch": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-\\./]{1,128}$",
          "description": "Target branch associated with this commit proposal."
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared_by", "role"],
      "properties": {
        "declared_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "enum": ["developer", "agent", "automated_bot"]
        },
        "agent_id": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "ci_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_path",
        "run_id",
        "run_attempt",
        "expected_policy_ref",
        "expected_policy_digest",
        "expected_jobs",
        "observed_jobs"
      ],
      "properties": {
        "workflow_path": {
          "type": "string",
          "pattern": "^\\.github/workflows/[a-zA-Z0-9_\\-\\.]+\\.(yml|yaml)$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$",
          "description": "Canonical decimal string of workflow run ID. Bounded by uint64::MAX (18446744073709551615) during semantic validation."
        },
        "run_attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "event": {
          "type": "string",
          "maxLength": 64
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$",
          "description": "Commit SHA at the head of the branch/PR when workflow was triggered."
        },
        "actual_checkout_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$",
          "description": "Exact commit SHA checked out and executed by CI runner."
        },
        "expected_policy_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Path or identifier of the approved check policy baseline."
        },
        "expected_policy_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 digest of the independently approved check policy."
        },
        "expected_jobs": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "observed_jobs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_\\-\\./ ]{1,100}$",
                "description": "Workflow job name"
              },
              "status": {
                "type": "string",
                "enum": ["queued", "in_progress", "completed"]
              },
              "conclusion": {
                "type": ["string", "null"],
                "enum": [
                  null,
                  "success",
                  "failure",
                  "cancelled",
                  "skipped",
                  "timed_out",
                  "action_required",
                  "neutral"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": { "enum": ["queued", "in_progress"] }
                  }
                },
                "then": {
                  "properties": {
                    "conclusion": { "type": "null" }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": { "const": "completed" }
                  }
                },
                "then": {
                  "required": ["conclusion"],
                  "properties": {
                    "conclusion": {
                      "type": "string",
                      "enum": [
                        "success",
                        "failure",
                        "cancelled",
                        "skipped",
                        "timed_out",
                        "action_required",
                        "neutral"
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "artifact_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_name",
          "artifact_id",
          "run_id",
          "run_attempt",
          "digest_algorithm",
          "digest_value",
          "size_bytes"
        ],
        "properties": {
          "artifact_name": { "type": "string" },
          "artifact_id": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
          "run_id": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
          "run_attempt": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "digest_algorithm": { "type": "string", "enum": ["sha256", "sha512"] },
          "digest_value": { "type": "string", "pattern": "^[0-9a-f]{64,128}$" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "upload_timestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
          },
          "retention_days": { "type": "integer", "minimum": 1, "maximum": 365 },
          "is_archive": { "type": "boolean" }
        },
        "allOf": [
          {
            "if": { "properties": { "digest_algorithm": { "const": "sha256" } } },
            "then": { "properties": { "digest_value": { "pattern": "^[0-9a-f]{64}$" } } }
          },
          {
            "if": { "properties": { "digest_algorithm": { "const": "sha512" } } },
            "then": { "properties": { "digest_value": { "pattern": "^[0-9a-f]{128}$" } } }
          }
        ]
      }
    },
    "review_declarations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewer_id", "review_type", "scope", "target_commit_sha"],
        "properties": {
          "reviewer_id": { "type": "string" },
          "review_type": {
            "type": "string",
            "enum": [
              "human_independent",
              "ai_agent_self_report",
              "automated_static"
            ]
          },
          "scope": { "type": "string" },
          "target_commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
          "findings_summary": { "type": "string" }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "related_issues": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        },
        "related_prs": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        },
        "decision_refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalization_algorithm", "digest_algorithm"],
      "properties": {
        "canonicalization_algorithm": {
          "type": "string",
          "enum": ["RFC8785"]
        },
        "digest_algorithm": {
          "type": "string",
          "enum": ["sha256"]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "git_hash_algorithm": { "const": "sha1" }
            }
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "commit_sha": { "pattern": "^[0-9a-f]{40}$" },
              "tree_hash": { "pattern": "^[0-9a-f]{40}$" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "git_hash_algorithm": { "const": "sha256" }
            }
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "commit_sha": { "pattern": "^[0-9a-f]{64}$" },
              "tree_hash": { "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    }
  ]
}
